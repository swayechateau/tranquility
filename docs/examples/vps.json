{
  "vps": [
    {
      "id": "dev-vm",
      "name": "Dev VM",
      "host": "10.0.0.5"
    },
    {
      "name": "staging",
      "user": "root",
      "host": "staging.example.com",
      "private_key": "~/.ssh/staging_id_rsa",
      "post_connect_script": "./scripts/bootstrap.sh"
    },
    {
      "name": "prod",
      "user": "deploy",
      "host": "prod.example.com",
      "port": "2222",
      "private_key": "~/.ssh/staging_id_rsa",
      "post_connect_script": "echo Connected && uptime"
    }
  ]
}